# Postgres password (docker-compose builds DATABASE_URL from it)
POSTGRES_PASSWORD=change-me

# Public address people open on their phones
APP_URL=https://maintenance.example.org

# Where uploaded photos and files are stored
UPLOAD_DIR=/data/uploads

# Outgoing email for sign-in codes and alerts. Leave SMTP_HOST empty to print codes to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Springs Maintenance <maintenance@example.org>"

# Push alerts to Vlad's phone when someone reports a problem. Generate once with: npm run vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:maintenance@example.org

# Office TV board (/tv). TV_KEY is a long random secret in the TV's link, e.g. from: openssl rand -hex 24
TV_KEY=
# Vlad's private calendar link(s) in iCal format, comma-separated (Google: Settings → calendar → "Secret address in iCal format";
# Outlook: Settings → Calendar → Shared calendars → Publish a calendar → ICS link)
CALENDAR_ICS_URL=
# Your time zone, used by the TV board and the daily digest
TZ=America/Chicago

# Claude API key for reading nameplate photos (phase 4)
ANTHROPIC_API_KEY=

# Hour of the day (server time) for the daily overdue / low-stock email to admins
DIGEST_HOUR=7

# Cloudflare Tunnel token, only if you run with --profile tunnel
CLOUDFLARE_TUNNEL_TOKEN=
